# --- Groq (required) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_S=30.0
GROQ_MAX_RETRIES=5

# --- Web search ("infinite information" pipeline) ---
# Auto priority: Tavily > SerpAPI > Serper > DuckDuckGo (see
# zane/tools/web_search.py). Leave all three keys blank to use the free
# DuckDuckGo backend automatically. Never hardcode any of these — env-only,
# like every other credential here.
TAVILY_API_KEY=
SERPAPI_API_KEY=
SERPER_API_KEY=
SEARCH_BACKEND=auto
SEARCH_MAX_RESULTS=5

# --- Page fetch tool (zane/tools/fetch_page.py) ---
# No API key needed — fetches a specific URL (typically from a web_search
# result) and reads its full text. Refuses private/loopback/internal
# addresses (SSRF guard); see the module docstring.
FETCH_PAGE_TIMEOUT_S=10.0
FETCH_PAGE_MAX_CHARS=6000

# --- Personality ---
ZANE_HUMOR_DEFAULT=false

# --- Rolling in-context memory window ---
ZANE_MEMORY_MAX_MESSAGES=40
ZANE_MEMORY_MAX_CHARS=24000

# --- Persistent, retrieval-augmented memory ---
ZANE_MEMORY_DB_PATH=zane_memory.sqlite3
ZANE_MEMORY_VECTOR_INDEX_PATH=zane_memory.faiss
ZANE_MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2
ZANE_MEMORY_RETRIEVAL_TOP_K=5
ZANE_MEMORY_RETENTION_WINDOW=20
ZANE_MEMORY_SUMMARIZE_AFTER_N=20

# --- C++ analytics engine ---
ZANE_ANALYTICS_WORKERS=2
ZANE_ANALYTICS_SEED=0

# --- Voice (ElevenLabs text-to-speech) ---
# Optional: leave blank to run text-only. Never hardcode these — they must
# only ever come from the environment, and ZANE_VOICE_ID should be a voice
# distinct from any other assistant persona's voice.
ELEVENLABS_API_KEY=
ZANE_VOICE_ID=
ZANE_VOICE_MODEL_ID=eleven_multilingual_v2
ZANE_VOICE_OUTPUT_FORMAT=mp3_44100_128
ZANE_VOICE_MAX_RETRIES=4
ZANE_VOICE_DEFAULT=false

# --- Ice Protocol (thermal safety governor) ---
# Defaults OFF: inert by construction in most container/cloud deployments
# (no thermal sensors exposed to the guest) — see zane/thermal_monitor.py.
ZANE_ICE_PROTOCOL_ENABLED=false
ZANE_ICE_PROTOCOL_THRESHOLD_C=75.0
ZANE_ICE_PROTOCOL_HYSTERESIS_C=5.0
ZANE_ICE_PROTOCOL_POLL_INTERVAL_S=5.0

# --- Falcon Scout (system log/health daemon) ---
# Defaults ON: pure observability, no effect on response behavior.
ZANE_FALCON_SCOUT_ENABLED=true
ZANE_FALCON_SCOUT_INTERVAL_S=60.0
ZANE_FALCON_SCOUT_LATENCY_THRESHOLD_MS=1500.0
ZANE_FALCON_SCOUT_DB_LATENCY_THRESHOLD_MS=200.0

# --- Memory Defragmenter (RAG conflict resolution) ---
# Defaults OFF: autonomously deletes memory rows (only ever on an explicit
# LLM-confirmed conflict) — a conservative opt-in given the consequence of
# a mistake. See zane/memory/memory_defragmenter.py.
ZANE_MEMORY_DEFRAG_ENABLED=false
ZANE_MEMORY_DEFRAG_INTERVAL_S=300.0
ZANE_MEMORY_DEFRAG_SIMILARITY_THRESHOLD=0.90
ZANE_MEMORY_DEFRAG_HALF_LIFE_HOURS=168.0

# --- Physical hardware integration (zane/hardware/) ---
# Master switch. Defaults OFF: none of this hardware exists in the
# Render/Docker deployment. Even when enabled, everything still runs
# against MockHAL (a terminal log) unless ZANE_HARDWARE_USE_REAL_GPIO is
# also set — see zane/hardware/hal.py and requirements-hardware.txt
# (Raspberry Pi only; never installed by the Docker build).
ZANE_HARDWARE_ENABLED=false
ZANE_HARDWARE_USE_REAL_GPIO=false

# Vision (zane/hardware/vision_processor.py)
ZANE_HARDWARE_CAMERA_INDEX=0
ZANE_HARDWARE_VISION_INTERVAL_S=1.0

# Peripherals: cryo-discharge solenoid + NeoPixel ring
# (zane/hardware/peripheral_io.py). ZANE_HARDWARE_CRYO_ARMED is a SEPARATE
# gate from ZANE_HARDWARE_ENABLED — the solenoid tool stays disarmed
# (refuses every request) even with hardware fully enabled, unless this
# is explicitly also set true. Never enable this without understanding
# the safety notes in peripheral_io.py's module docstring.
ZANE_HARDWARE_CRYO_RELAY_PIN=17
ZANE_HARDWARE_CRYO_ARMED=false
ZANE_HARDWARE_CRYO_MAX_DISCHARGE_S=2.0
ZANE_HARDWARE_CRYO_COOLDOWN_S=5.0
ZANE_HARDWARE_NEOPIXEL_PIN=18
ZANE_HARDWARE_NEOPIXEL_COUNT=16

# Acoustic localization / neck-tracking servo (zane/hardware/sensory_localization.py)
ZANE_HARDWARE_NECK_SERVO_PIN=22
ZANE_HARDWARE_DOA_SMOOTHING_ALPHA=0.3

# Hardware state controller / Humor Switch override
# (zane/hardware/hardware_state_controller.py). Leave both blank to
# disable both trigger paths (the fault-state trigger from Falcon Scout
# still works either way).
ZANE_HARDWARE_HUMOR_GPIO_PIN=
ZANE_HARDWARE_OVERRIDE_SOCKET_PORT=

# --- Archival lore database (zane/knowledge_manager.py) ---
# A physically separate FAISS index from chat memory — never mixes with
# organic conversation history. Empty/harmless until you run:
#   python -m zane.knowledge_manager data/raw_lore.txt
ZANE_LORE_INDEX_PATH=data/ninjago_lore.index
ZANE_LORE_METADATA_PATH=data/ninjago_lore.json
ZANE_LORE_RETRIEVAL_TOP_K=3

# --- Wolfram|Alpha analytical math tool (zane/tools/wolfram_tool.py) ---
# Optional: the tool stays available without this, falling back to a
# local restricted-arithmetic evaluator (numeric expressions only, not
# natural-language physics queries) — see the module docstring.
WOLFRAM_APP_ID=
WOLFRAM_TIMEOUT_S=10.0

# --- P.I.X.A.L. companion bridge (zane/companion_bridge.py) ---
# Dual-voice routing: leave PIXAL_VOICE_ID blank to keep her notices
# text-only (folded into the prompt either way) even if Zane's own voice
# is configured and on. Never hardcode a voice ID.
PIXAL_VOICE_ID=
ZANE_PIXAL_BATTERY_VOLTAGE_THRESHOLD_V=10.5
