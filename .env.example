# --- Groq (required) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_S=30.0
GROQ_MAX_RETRIES=5

# --- Web search ("infinite information" pipeline) ---
# Leave TAVILY_API_KEY blank to use the free DuckDuckGo backend automatically.
TAVILY_API_KEY=
SEARCH_BACKEND=auto
SEARCH_MAX_RESULTS=5

# --- Personality ---
ZANE_HUMOR_DEFAULT=false

# --- Rolling in-context memory window ---
ZANE_MEMORY_MAX_MESSAGES=40
ZANE_MEMORY_MAX_CHARS=24000

# --- Persistent, retrieval-augmented memory ---
ZANE_MEMORY_DB_PATH=zane_memory.sqlite3
ZANE_MEMORY_VECTOR_INDEX_PATH=zane_memory.faiss
ZANE_MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2
ZANE_MEMORY_RETRIEVAL_TOP_K=5
ZANE_MEMORY_RETENTION_WINDOW=20
ZANE_MEMORY_SUMMARIZE_AFTER_N=20

# --- C++ analytics engine ---
ZANE_ANALYTICS_WORKERS=2
ZANE_ANALYTICS_SEED=0

# --- Voice (ElevenLabs text-to-speech) ---
# Optional: leave blank to run text-only. Never hardcode these — they must
# only ever come from the environment, and ZANE_VOICE_ID should be a voice
# distinct from any other assistant persona's voice.
ELEVENLABS_API_KEY=
ZANE_VOICE_ID=
ZANE_VOICE_MODEL_ID=eleven_multilingual_v2
ZANE_VOICE_OUTPUT_FORMAT=mp3_44100_128
ZANE_VOICE_MAX_RETRIES=4
ZANE_VOICE_DEFAULT=false
