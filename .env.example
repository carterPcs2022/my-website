# --- Groq (required) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_S=30.0
GROQ_MAX_RETRIES=5

# --- Web search ("infinite information" pipeline) ---
# Leave TAVILY_API_KEY blank to use the free DuckDuckGo backend automatically.
TAVILY_API_KEY=
SEARCH_BACKEND=auto
SEARCH_MAX_RESULTS=5

# --- Personality ---
ZANE_HUMOR_DEFAULT=false

# --- Conversational memory ---
ZANE_MEMORY_MAX_MESSAGES=40
ZANE_MEMORY_MAX_CHARS=24000

# --- C++ analytics engine ---
ZANE_ANALYTICS_WORKERS=2
ZANE_ANALYTICS_SEED=0

# --- Discord deployment surface (optional) ---
DISCORD_BOT_TOKEN=
